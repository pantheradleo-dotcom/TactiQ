<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>TactiQ V2 — Assistant OPJ local</title>
<link rel="icon" href="data:," />
<style>
:root{
  --bg:#0b0e13; --bg2:#10151d; --bg3:#161d28; --panel:#121821;
  --line:#232c39; --line2:#2d394b; --ink:#d8e1f0; --ink2:#92a5bf; --ink3:#61728a;
  --accent:#e7a128; --accent2:#c77a0d; --accentSoft:rgba(231,161,40,.1);
  --green:#28c06f; --red:#eb5757; --blue:#4d8df7; --radius:12px; --radius2:16px;
  --shadow:0 14px 40px rgba(0,0,0,.35);
  --font-ui:'Segoe UI',Arial,sans-serif; --font-mono:'Consolas','Courier New',monospace;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%;font-family:var(--font-ui);background:var(--bg);color:var(--ink)}
body{overflow:hidden}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
.hidden{display:none !important}
.shell{display:grid;grid-template-columns:340px 1fr;grid-template-rows:58px 1fr;height:100vh}
.topbar{grid-column:1/-1;display:flex;align-items:center;gap:14px;padding:0 16px;background:var(--bg2);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:10px;min-width:220px}
.brand-mark{width:34px;height:34px;border-radius:10px;border:2px solid var(--accent);display:grid;place-items:center;color:var(--accent);font-weight:800;background:var(--accentSoft)}
.brand-text strong{display:block;letter-spacing:.12em}
.brand-text span{font-size:.72rem;color:var(--ink3);font-family:var(--font-mono)}
.top-actions{display:flex;gap:8px;align-items:center;margin-left:auto}
.status{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--line);border-radius:999px;background:var(--bg3);font-family:var(--font-mono);font-size:.72rem;color:var(--ink3)}
.dot{width:8px;height:8px;border-radius:50%;background:var(--ink3)}
.dot.ok{background:var(--green);box-shadow:0 0 10px var(--green)}
.dot.err{background:var(--red);box-shadow:0 0 10px var(--red)}
.dot.load{background:var(--accent);animation:pulse .9s infinite}
@keyframes pulse{50%{opacity:.35}}
.sidebar{background:var(--panel);border-right:1px solid var(--line);overflow:auto;padding:14px;display:flex;flex-direction:column;gap:12px}
.panel{background:var(--bg2);border:1px solid var(--line);border-radius:var(--radius2);overflow:hidden;box-shadow:var(--shadow)}
.panel-head{padding:10px 14px;border-bottom:1px solid var(--line);font-family:var(--font-mono);font-size:.7rem;letter-spacing:.12em;color:var(--ink3);text-transform:uppercase;background:rgba(255,255,255,.02)}
.panel-body{padding:14px;display:flex;flex-direction:column;gap:10px}
.field{display:flex;flex-direction:column;gap:6px}
.field label{font-size:.68rem;color:var(--ink3);text-transform:uppercase;letter-spacing:.08em;font-family:var(--font-mono)}
input[type=text], textarea, select{width:100%;border:1px solid var(--line2);border-radius:10px;background:var(--bg);color:var(--ink);padding:10px 12px;outline:none}
textarea{resize:vertical;min-height:90px;line-height:1.55}
input:focus, textarea:focus, select:focus{border-color:var(--accent2);box-shadow:0 0 0 3px rgba(231,161,40,.12)}
.row{display:flex;gap:8px;align-items:center}
.row.wrap{flex-wrap:wrap}
.btn{border:none;border-radius:10px;padding:10px 12px;font-weight:700;letter-spacing:.04em}
.btn-primary{background:linear-gradient(135deg,var(--accent2),var(--accent));color:#120b00}
.btn-soft{background:var(--bg3);border:1px solid var(--line2);color:var(--ink2)}
.btn-soft:hover{border-color:var(--accent2);color:var(--ink)}
.btn-full{width:100%;justify-content:center}
.btn-tiny{padding:6px 8px;border-radius:8px;font-size:.75rem;background:var(--bg3);color:var(--ink2);border:1px solid var(--line2)}
.note{font-size:.76rem;color:var(--ink2);line-height:1.55;border:1px dashed var(--line2);background:var(--bg);border-radius:10px;padding:10px}
.pills{display:flex;flex-wrap:wrap;gap:6px}
.pill{padding:6px 10px;border-radius:999px;border:1px solid var(--line2);background:var(--bg);color:var(--ink3);font-size:.77rem;font-weight:700}
.pill.active{border-color:var(--accent2);background:var(--accentSoft);color:var(--accent)}
.main{display:flex;flex-direction:column;min-width:0}
.modebar{display:flex;gap:8px;overflow:auto;padding:12px 16px;border-bottom:1px solid var(--line);background:rgba(255,255,255,.01)}
.mode-btn{background:transparent;border:1px solid var(--line2);color:var(--ink2);padding:9px 12px;border-radius:999px;white-space:nowrap;font-weight:700}
.mode-btn.active{background:var(--accentSoft);border-color:var(--accent2);color:var(--accent)}
.chat{flex:1;overflow:auto;padding:18px;display:flex;flex-direction:column;gap:14px}
.empty{margin:auto;max-width:560px;text-align:center;color:var(--ink3)}
.empty h2{color:var(--ink);letter-spacing:.08em}
.quick{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:16px}
.quick button{background:var(--bg2);border:1px solid var(--line);color:var(--ink);padding:14px;border-radius:14px;text-align:left}
.quick small{display:block;color:var(--ink3);margin-top:5px}
.msg{max-width:960px;display:flex;flex-direction:column;gap:6px;animation:fade .18s ease}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.msg.user{align-self:flex-end}
.msg.assistant{align-self:flex-start;width:min(100%,960px)}
.meta{font-size:.68rem;color:var(--ink3);font-family:var(--font-mono);display:flex;gap:8px;align-items:center}
.badge{padding:2px 7px;border-radius:999px;background:var(--accentSoft);border:1px solid rgba(231,161,40,.2);color:var(--accent)}
.msg.user .badge{background:rgba(77,141,247,.1);border-color:rgba(77,141,247,.2);color:var(--blue)}
.bubble{padding:14px 16px;border-radius:14px;line-height:1.65;border:1px solid var(--line);background:var(--bg2);word-break:break-word}
.msg.user .bubble{background:var(--bg3);border-color:var(--line2)}
.actions{display:flex;gap:6px;flex-wrap:wrap}
.bubble h1,.bubble h2,.bubble h3{margin:.9em 0 .45em;color:var(--accent)}
.bubble p{margin:.55em 0}
.bubble ul,.bubble ol{padding-left:1.4em}
.bubble code{background:var(--bg3);border:1px solid var(--line2);padding:1px 5px;border-radius:5px;font-family:var(--font-mono);color:var(--accent)}
.bubble pre{background:var(--bg3);border:1px solid var(--line2);padding:10px;border-radius:10px;overflow:auto}
.inputbar{border-top:1px solid var(--line);padding:14px 16px;background:var(--bg2);display:flex;flex-direction:column;gap:10px}
.inputrow{display:flex;gap:10px;align-items:flex-end}
.chatInput{flex:1;min-height:58px;max-height:160px}
.hintline{display:flex;justify-content:space-between;gap:10px;font-size:.7rem;color:var(--ink3);font-family:var(--font-mono)}
.history-list{display:flex;flex-direction:column;gap:7px}
.hist{display:flex;gap:8px;align-items:center;border:1px solid var(--line2);background:var(--bg);padding:8px 9px;border-radius:10px;cursor:pointer}
.hist strong{font-size:.68rem;color:var(--accent);font-family:var(--font-mono)}
.hist span{font-size:.78rem;color:var(--ink2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hist time{font-size:.66rem;color:var(--ink3);font-family:var(--font-mono);margin-left:auto}
.model-list{display:flex;flex-direction:column;gap:6px;max-height:170px;overflow:auto}
.model-item{display:flex;justify-content:space-between;align-items:center;border:1px solid var(--line2);background:var(--bg);border-radius:10px;padding:8px 10px;cursor:pointer}
.model-item.active{border-color:var(--accent2);background:var(--accentSoft)}
.toast{position:fixed;right:18px;bottom:18px;background:var(--bg2);border:1px solid var(--line2);padding:12px 14px;border-radius:12px;box-shadow:var(--shadow);opacity:0;transform:translateY(8px);transition:.18s;pointer-events:none;color:var(--ink);z-index:1000}
.toast.show{opacity:1;transform:none}
.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.65);display:none;align-items:center;justify-content:center;z-index:999}
.modal-backdrop.show{display:flex}
.modal{width:min(900px,95vw);max-height:90vh;overflow:auto;background:var(--bg2);border:1px solid var(--line2);border-radius:18px;box-shadow:var(--shadow)}
.modal-head{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line)}
.modal-body{padding:16px;display:grid;grid-template-columns:220px 1fr;gap:14px}
.cfg-tabs{display:flex;flex-direction:column;gap:8px}
.cfg-tab{padding:10px 12px;border-radius:10px;border:1px solid var(--line2);background:var(--bg);color:var(--ink2);text-align:left}
.cfg-tab.active{background:var(--accentSoft);border-color:var(--accent2);color:var(--accent)}
.cfg-panel{display:none;flex-direction:column;gap:10px}
.cfg-panel.active{display:flex}
.dropzone{border:1.5px dashed var(--line2);border-radius:12px;padding:14px;text-align:center;position:relative;background:var(--bg)}
.dropzone.drag{border-color:var(--accent2);background:var(--accentSoft)}
.dropzone input{position:absolute;inset:0;opacity:0}
.doc-badge{display:flex;justify-content:space-between;align-items:center;background:var(--accentSoft);border:1px solid rgba(231,161,40,.2);padding:8px 10px;border-radius:10px}
.summary{font-size:.76rem;color:var(--ink2)}
@media (max-width:980px){
  .shell{grid-template-columns:1fr;grid-template-rows:58px auto 1fr}
  .sidebar{max-height:42vh;border-right:none;border-bottom:1px solid var(--line)}
  .quick{grid-template-columns:1fr}
  .modal-body{grid-template-columns:1fr}
  .topbar{gap:8px}
  .brand{min-width:0}
}
</style>
</head>
<body>
<div class="shell">
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark">T</div>
      <div class="brand-text"><strong>TACTIQ V2</strong><span>OPJ · OLLAMA · LOCAL</span></div>
    </div>
    <div class="top-actions">
      <button class="btn btn-soft" id="openConfigBtn">⚙ Config</button>
      <button class="btn btn-soft" id="exportMdBtn">Export .md</button>
      <button class="btn btn-soft" id="exportTxtBtn">Export .txt</button>
      <div class="status"><span class="dot" id="statusDot"></span><span id="statusLabel">HORS LIGNE</span></div>
    </div>
  </header>

  <aside class="sidebar">
    <section class="panel">
      <div class="panel-head">IA locale Ollama</div>
      <div class="panel-body">
        <div class="field">
          <label for="ollamaUrl">URL serveur</label>
          <input id="ollamaUrl" type="text" value="http://127.0.0.1:11434" />
        </div>
        <div class="field">
          <label for="ollamaModel">Modèle</label>
          <input id="ollamaModel" type="text" value="mistral:latest" list="modelsDatalist" />
          <datalist id="modelsDatalist"></datalist>
        </div>
        <div class="row wrap">
          <button class="btn btn-soft" id="testBtn">Tester</button>
          <button class="btn btn-soft" id="refreshModelsBtn">Détecter les modèles</button>
          <button class="btn btn-soft" id="bestModelBtn">Meilleur choix</button>
        </div>
        <div class="note">Cette v2 mémorise localement l’URL, le modèle, le contexte dossier, l’historique et les prompts personnalisés.</div>
        <div class="model-list hidden" id="modelsPanel"></div>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head">Contexte dossier</div>
      <div class="panel-body">
        <div class="field">
          <label for="affaireType">Type d'affaire</label>
          <select id="affaireType">
            <option value="">— Sélectionner —</option>
            <option value="homicide">Homicide / Tentative</option>
            <option value="viol">Viol / Agression sexuelle</option>
            <option value="violences">Violences physiques</option>
            <option value="trafic">Trafic de stupéfiants</option>
            <option value="escroquerie">Escroquerie / Fraude</option>
            <option value="terrorisme">Terrorisme / Radicalisation</option>
            <option value="mineur">Mineur</option>
            <option value="autre">Autre</option>
          </select>
        </div>
        <div class="field">
          <label>Profil interlocuteur</label>
          <div class="pills" id="profilGroup">
            <button class="pill" data-val="suspect">Suspect</button>
            <button class="pill" data-val="victime">Victime</button>
            <button class="pill" data-val="temoin">Témoin</button>
            <button class="pill" data-val="mis_en_cause">Mis en cause</button>
            <button class="pill" data-val="mineur">Mineur</button>
          </div>
        </div>
        <div class="field">
          <label>Comportement anticipé</label>
          <div class="pills" id="comportGroup">
            <button class="pill" data-val="cooperant">Coopérant</button>
            <button class="pill" data-val="mutique">Mutique</button>
            <button class="pill" data-val="manipulateur">Manipulateur</button>
            <button class="pill" data-val="agressif">Agressif</button>
            <button class="pill" data-val="traumatise">Traumatisé</button>
            <button class="pill" data-val="anxieux">Anxieux</button>
          </div>
        </div>
        <div class="field">
          <label>Éléments disponibles</label>
          <div class="pills" id="elemGroup">
            <button class="pill" data-val="aveux_partiels">Aveux partiels</button>
            <button class="pill" data-val="preuves_numeriques">Preuves numériques</button>
            <button class="pill" data-val="temoignages">Témoignages</button>
            <button class="pill" data-val="expertise">Expertise</button>
            <button class="pill" data-val="videosurveillance">Vidéosurveillance</button>
            <button class="pill" data-val="aucun">Aucun</button>
          </div>
        </div>
        <div class="field">
          <label for="contextText">Résumé des faits</label>
          <textarea id="contextText" rows="4" placeholder="Contexte, chronologie, points saillants…"></textarea>
        </div>
        <div class="field">
          <label for="dossierSummary">Résumé mémoire de dossier</label>
          <textarea id="dossierSummary" rows="3" placeholder="Résumé compact réutilisable entre les échanges…"></textarea>
        </div>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head">Document local</div>
      <div class="panel-body">
        <div class="dropzone" id="dropZone">
          <input type="file" id="docInput" accept=".txt,.md,.pdf" />
          <strong>Glisser un TXT / MD / PDF</strong>
          <div class="summary">Le PDF est pris en charge en mode texte simple. Les PDF scannés resteront limités.</div>
        </div>
        <div id="docBadgeWrap" class="hidden">
          <div class="doc-badge"><span id="docName">—</span><button class="btn-tiny" id="clearDocBtn">Retirer</button></div>
          <div class="summary" id="docMeta"></div>
          <div class="row wrap">
            <button class="btn btn-soft" id="docSynthBtn">Synthèse doc</button>
            <button class="btn btn-soft" id="docQuestionsBtn">Questions doc</button>
          </div>
        </div>
      </div>
    </section>

    <section class="panel" id="historyPanel">
      <div class="panel-head">Historique session</div>
      <div class="panel-body">
        <div class="history-list" id="historyList"></div>
        <button class="btn btn-soft" id="clearSessionBtn">Nouvelle session</button>
      </div>
    </section>
  </aside>

  <main class="main">
    <nav class="modebar" id="modeBar"></nav>
    <div class="chat" id="chatArea">
      <div class="empty" id="emptyState">
        <h2>TactiQ V2 prêt</h2>
        <p>V2 ajoute la persistance locale, la détection de modèles Ollama, l’export, un résumé de dossier mémorisé et un module document plus clair.</p>
        <div class="quick">
          <button data-template="trame"><strong>🎯 Trame d'audition</strong><small>Plan progressif, confrontation et plan B.</small></button>
          <button data-template="profil"><strong>🧠 Analyse de profil</strong><small>Mécanismes de défense, leviers, posture.</small></button>
          <button data-template="victime"><strong>🛡 Audition victime</strong><small>Confiance, rappel libre, gestion émotionnelle.</small></button>
          <button data-template="synthese"><strong>📋 Synthèse judiciaire</strong><small>Faits établis, contradictions, actes utiles.</small></button>
        </div>
      </div>
    </div>
    <div class="inputbar">
      <div class="inputrow">
        <textarea class="chatInput" id="userInput" rows="3" placeholder="Décrivez votre besoin opérationnel…"></textarea>
        <button class="btn btn-primary" id="sendBtn">▶ Envoyer</button>
      </div>
      <div class="hintline">
        <span>Ctrl + Entrée pour envoyer · Contexte dossier injecté automatiquement</span>
        <span>Contexte : <strong id="ctxCount">0</strong> échange(s)</span>
      </div>
    </div>
  </main>
</div>

<div class="toast" id="toast"></div>
<div class="modal-backdrop" id="cfgModal">
  <div class="modal">
    <div class="modal-head">
      <strong>Configuration des prompts</strong>
      <button class="btn btn-soft" id="closeConfigBtn">Fermer</button>
    </div>
    <div class="modal-body">
      <div class="cfg-tabs" id="cfgTabs"></div>
      <div id="cfgPanels"></div>
    </div>
  </div>
</div>

<script>
const STORAGE_KEY = 'tactiq_v2_state';
const MAX_CTX_PAIRS = 6;
const MAX_HISTORY = 20;
const MAX_SESSION_ITEMS = 12;

const SYSTEM_PROMPT = `Tu es un Officier de Police Judiciaire (OPJ) expert en stratégie d'enquête, procédure pénale française et analyse comportementale. Tu réponds en français, de manière opérationnelle, rigoureuse, structurée et utile. Tu dois toujours distinguer les faits, les hypothèses et les précautions procédurales. Utilise du Markdown clair.`;

const MODE_CONFIGS = {
  strategie: { label: '🎯 Stratégie d\'audition', short: 'STRATÉGIE', ph: "Ex : suspect mutique avec preuve vidéo partielle.", prompt: `MODE : STRATÉGIE D'AUDITION\nStructure :\n## Objectif\n## Entrée\n## Séquençage\n## Confrontation\n## Signaux d'alerte\n## Plan B\n## Clôture\nMéthode PEACE. Respecter CPP et CEDH.` },
  profil: { label: '🧠 Analyse de profil', short: 'PROFIL', ph: "Ex : mis en cause défensif, contradictions multiples.", prompt: `MODE : ANALYSE DE PROFIL\nStructure :\n## Profil probable\n## Défenses anticipées\n## Leviers éthiques\n## Pièges à éviter\n## Signaux à surveiller\n## Adaptation du registre` },
  droit: { label: '⚖️ Droit & Procédure', short: 'DROIT', ph: "Ex : quels actes restent possibles après refus de prolongation ?", prompt: `MODE : DROIT & PROCÉDURE PÉNALE\nStructure :\n## Qualification\n## Cadre procédural\n## Droits à notifier\n## Actes autorisés\n## Risques de nullité\n## Recommandations\nCiter les articles quand possible et signaler les incertitudes.` },
  synthese: { label: '📋 Synthèse d\'enquête', short: 'SYNTHÈSE', ph: "Ex : résume les charges, contradictions et actes complémentaires.", prompt: `MODE : SYNTHÈSE D'ENQUÊTE\nStructure :\n## Faits établis\n## Zones d'ombre\n## Chronologie\n## Charges\n## Hypothèses\n## Contradictions\n## Actes complémentaires\n## Conclusion` },
  libre: { label: '💬 Conseil libre', short: 'CONSEIL', ph: "Pose toute question opérationnelle.", prompt: `MODE : CONSEIL LIBRE\nRéponds de manière concise, utile et actionnable. Ajoute des garde-fous éthiques et procéduraux si pertinent.` }
};

const TEMPLATES = {
  trame: "Génère une trame d'audition complète selon le contexte : objectifs, thèmes, questions, confrontation, signaux d'alerte et stratégie de repli.",
  profil: "Analyse le profil psychologique de l'interlocuteur selon le contexte. Donne mécanismes de défense, leviers, pièges et posture adaptée.",
  victime: "Propose un protocole d'audition victime : confiance, rappel libre, relances, gestion émotionnelle et précautions.",
  synthese: "Fais une synthèse judiciaire : faits établis, contradictions, hypothèses, actes complémentaires et orientation."
};

const CFG_TABS = [
  {id:'system', label:'⚙ Système', desc:'Prompt système global.'},
  {id:'strategie', label:'🎯 Stratégie', desc:'Prompt du mode stratégie.'},
  {id:'profil', label:'🧠 Profil', desc:'Prompt du mode profil.'},
  {id:'droit', label:'⚖️ Droit', desc:'Prompt du mode droit.'},
  {id:'synthese', label:'📋 Synthèse', desc:'Prompt du mode synthèse.'},
  {id:'libre', label:'💬 Libre', desc:'Prompt du mode libre.'}
];

const state = {
  currentMode: 'strategie',
  conversationHistory: [],
  sessionHistory: [],
  isLoading: false,
  selectedModelFromList: '',
  userPrompts: {},
  userSystemPrompt: '',
  models: [],
  doc: null,
  cfgActiveTab: 'system'
};

const dom = {
  statusDot: document.getElementById('statusDot'), statusLabel: document.getElementById('statusLabel'),
  ollamaUrl: document.getElementById('ollamaUrl'), ollamaModel: document.getElementById('ollamaModel'),
  testBtn: document.getElementById('testBtn'), refreshModelsBtn: document.getElementById('refreshModelsBtn'), bestModelBtn: document.getElementById('bestModelBtn'),
  modelsPanel: document.getElementById('modelsPanel'), modelsDatalist: document.getElementById('modelsDatalist'),
  affaireType: document.getElementById('affaireType'), contextText: document.getElementById('contextText'), dossierSummary: document.getElementById('dossierSummary'),
  historyList: document.getElementById('historyList'), clearSessionBtn: document.getElementById('clearSessionBtn'),
  modeBar: document.getElementById('modeBar'), chatArea: document.getElementById('chatArea'), emptyState: document.getElementById('emptyState'),
  userInput: document.getElementById('userInput'), sendBtn: document.getElementById('sendBtn'), ctxCount: document.getElementById('ctxCount'),
  toast: document.getElementById('toast'), exportMdBtn: document.getElementById('exportMdBtn'), exportTxtBtn: document.getElementById('exportTxtBtn'),
  openConfigBtn: document.getElementById('openConfigBtn'), cfgModal: document.getElementById('cfgModal'), closeConfigBtn: document.getElementById('closeConfigBtn'), cfgTabs: document.getElementById('cfgTabs'), cfgPanels: document.getElementById('cfgPanels'),
  dropZone: document.getElementById('dropZone'), docInput: document.getElementById('docInput'), docBadgeWrap: document.getElementById('docBadgeWrap'), docName: document.getElementById('docName'), docMeta: document.getElementById('docMeta'), clearDocBtn: document.getElementById('clearDocBtn'), docSynthBtn: document.getElementById('docSynthBtn'), docQuestionsBtn: document.getElementById('docQuestionsBtn')
};

function init(){
  hydrate();
  initPills('profilGroup', false);
  initPills('comportGroup', false);
  initPills('elemGroup', true);
  renderModeBar();
  renderHistory();
  renderConfigModal();
  bindEvents();
  updateCtx();
  autoResize(dom.userInput);
  renderDocumentState();
  if (state.sessionHistory.length || state.conversationHistory.length) rebuildChatFromState();
}

function bindEvents(){
  dom.testBtn.addEventListener('click', testConnection);
  dom.refreshModelsBtn.addEventListener('click', refreshModels);
  dom.bestModelBtn.addEventListener('click', chooseBestModel);
  dom.sendBtn.addEventListener('click', sendMessage);
  dom.clearSessionBtn.addEventListener('click', clearSession);
  dom.userInput.addEventListener('input', ()=> autoResize(dom.userInput));
  dom.userInput.addEventListener('keydown', (e)=>{ if(e.ctrlKey && e.key === 'Enter'){ e.preventDefault(); sendMessage(); } });
  [dom.ollamaUrl, dom.ollamaModel, dom.affaireType, dom.contextText, dom.dossierSummary].forEach(el=>el.addEventListener('input', persist));
  document.querySelectorAll('.quick button').forEach(btn=> btn.addEventListener('click', ()=>{ dom.userInput.value = TEMPLATES[btn.dataset.template] || ''; autoResize(dom.userInput); dom.userInput.focus(); hideEmpty(); }));
  dom.exportMdBtn.addEventListener('click', ()=> exportConversation('md'));
  dom.exportTxtBtn.addEventListener('click', ()=> exportConversation('txt'));
  dom.openConfigBtn.addEventListener('click', ()=> dom.cfgModal.classList.add('show'));
  dom.closeConfigBtn.addEventListener('click', ()=> dom.cfgModal.classList.remove('show'));
  dom.cfgModal.addEventListener('click', (e)=>{ if(e.target === dom.cfgModal) dom.cfgModal.classList.remove('show'); });
  dom.dropZone.addEventListener('dragover', e=>{ e.preventDefault(); dom.dropZone.classList.add('drag'); });
  dom.dropZone.addEventListener('dragleave', ()=> dom.dropZone.classList.remove('drag'));
  dom.dropZone.addEventListener('drop', (e)=>{ e.preventDefault(); dom.dropZone.classList.remove('drag'); handleDocFile(e.dataTransfer.files[0]); });
  dom.docInput.addEventListener('change', ()=> handleDocFile(dom.docInput.files[0]));
  dom.clearDocBtn.addEventListener('click', clearDocument);
  dom.docSynthBtn.addEventListener('click', ()=> injectDocTemplate('synthese'));
  dom.docQuestionsBtn.addEventListener('click', ()=> injectDocTemplate('questions'));
}

function hydrate(){
  try{
    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
    dom.ollamaUrl.value = saved.ollamaUrl || dom.ollamaUrl.value;
    dom.ollamaModel.value = saved.ollamaModel || dom.ollamaModel.value;
    dom.affaireType.value = saved.affaireType || '';
    dom.contextText.value = saved.contextText || '';
    dom.dossierSummary.value = saved.dossierSummary || '';
    state.currentMode = saved.currentMode || 'strategie';
    state.userPrompts = saved.userPrompts || {};
    state.userSystemPrompt = saved.userSystemPrompt || '';
    state.conversationHistory = Array.isArray(saved.conversationHistory) ? saved.conversationHistory : [];
    state.sessionHistory = Array.isArray(saved.sessionHistory) ? saved.sessionHistory.map(x => ({...x, time: new Date(x.time)})) : [];
    state.doc = saved.doc || null;
    restorePills(saved.pills || {});
  }catch(e){ console.warn(e); }
}

function persist(){
  const payload = {
    ollamaUrl: dom.ollamaUrl.value.trim(), ollamaModel: dom.ollamaModel.value.trim(), affaireType: dom.affaireType.value,
    contextText: dom.contextText.value, dossierSummary: dom.dossierSummary.value, currentMode: state.currentMode,
    userPrompts: state.userPrompts, userSystemPrompt: state.userSystemPrompt,
    conversationHistory: state.conversationHistory.slice(-MAX_CTX_PAIRS*2), sessionHistory: state.sessionHistory,
    doc: state.doc, pills: { profilGroup:getSelected('profilGroup'), comportGroup:getSelected('comportGroup'), elemGroup:getSelected('elemGroup') }
  };
  localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
}

function initPills(groupId, multi){
  document.querySelectorAll('#'+groupId+' .pill').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      if(multi){ btn.classList.toggle('active'); }
      else {
        const was = btn.classList.contains('active');
        document.querySelectorAll('#'+groupId+' .pill').forEach(x=>x.classList.remove('active'));
        if(!was) btn.classList.add('active');
      }
      persist();
    });
  });
}
function restorePills(map){ Object.keys(map).forEach(groupId=>{ document.querySelectorAll('#'+groupId+' .pill').forEach(btn=> btn.classList.toggle('active', (map[groupId]||[]).includes(btn.dataset.val))); }); }
function getSelected(groupId){ return Array.from(document.querySelectorAll('#'+groupId+' .pill.active')).map(b=>b.dataset.val); }

function renderModeBar(){
  dom.modeBar.innerHTML = '';
  Object.entries(MODE_CONFIGS).forEach(([key,cfg])=>{
    const btn = document.createElement('button');
    btn.className = 'mode-btn' + (key === state.currentMode ? ' active' : '');
    btn.textContent = cfg.label;
    btn.addEventListener('click', ()=>{ state.currentMode = key; renderModeBar(); dom.userInput.placeholder = cfg.ph; persist(); });
    dom.modeBar.appendChild(btn);
  });
  dom.userInput.placeholder = MODE_CONFIGS[state.currentMode].ph;
}

function renderConfigModal(){
  dom.cfgTabs.innerHTML = '';
  dom.cfgPanels.innerHTML = '';
  CFG_TABS.forEach(tab=>{
    const b = document.createElement('button');
    b.className = 'cfg-tab' + (tab.id === state.cfgActiveTab ? ' active' : '');
    b.textContent = tab.label;
    b.addEventListener('click', ()=>{ state.cfgActiveTab = tab.id; renderConfigModal(); });
    dom.cfgTabs.appendChild(b);

    const p = document.createElement('div');
    p.className = 'cfg-panel' + (tab.id === state.cfgActiveTab ? ' active' : '');
    const current = getPromptValue(tab.id);
    p.innerHTML = `<div class="note">${escapeHtml(tab.desc)}</div><textarea rows="16">${escapeHtml(current)}</textarea><div class="row wrap"><button class="btn btn-primary">Enregistrer</button><button class="btn btn-soft">Réinitialiser</button></div>`;
    const ta = p.querySelector('textarea');
    p.querySelector('.btn-primary').addEventListener('click', ()=>{
      if(tab.id === 'system') state.userSystemPrompt = ta.value.trim(); else state.userPrompts[tab.id] = ta.value.trim();
      persist(); toast('Prompts enregistrés.');
    });
    p.querySelector('.btn-soft').addEventListener('click', ()=>{
      if(tab.id === 'system') state.userSystemPrompt = ''; else delete state.userPrompts[tab.id];
      persist(); renderConfigModal(); toast('Prompt réinitialisé.');
    });
    dom.cfgPanels.appendChild(p);
  });
}
function getPromptValue(id){ if(id === 'system') return state.userSystemPrompt || SYSTEM_PROMPT; return state.userPrompts[id] ?? MODE_CONFIGS[id].prompt; }

function buildContext(){
  const parts = [];
  if(dom.affaireType.value) parts.push(`Type d'affaire : ${dom.affaireType.value}`);
  const profil = getSelected('profilGroup')[0] || '';
  if(profil) parts.push(`Profil interlocuteur : ${profil}`);
  const comport = getSelected('comportGroup')[0] || '';
  if(comport) parts.push(`Comportement anticipé : ${comport}`);
  const elems = getSelected('elemGroup');
  if(elems.length) parts.push(`Éléments disponibles : ${elems.join(', ')}`);
  if(dom.contextText.value.trim()) parts.push(`Contexte des faits :\n${dom.contextText.value.trim()}`);
  if(dom.dossierSummary.value.trim()) parts.push(`Résumé mémoire de dossier :\n${dom.dossierSummary.value.trim()}`);
  if(state.doc?.text) parts.push(`Extrait document chargé (${state.doc.name}) :\n${state.doc.text.slice(0, 7000)}`);
  return parts.length ? `[CONTEXTE DOSSIER]\n${parts.join('\n')}\n[FIN CONTEXTE]\n\n` : '';
}

function setStatus(kind, text){ dom.statusDot.className = 'dot ' + kind; dom.statusLabel.textContent = text; }
function toast(message){ dom.toast.textContent = message; dom.toast.classList.add('show'); clearTimeout(toast._t); toast._t = setTimeout(()=>dom.toast.classList.remove('show'), 2400); }
function hideEmpty(){ if(dom.emptyState) dom.emptyState.classList.add('hidden'); }
function updateCtx(){ dom.ctxCount.textContent = Math.floor(state.conversationHistory.length/2); }
function autoResize(el){ el.style.height='auto'; el.style.height=Math.min(el.scrollHeight,160)+'px'; }

async function fetchJson(url, options={}, timeoutMs=8000){
  const ctrl = new AbortController();
  const t = setTimeout(()=>ctrl.abort(), timeoutMs);
  try{
    const res = await fetch(url, {...options, signal: ctrl.signal});
    const text = await res.text();
    if(!res.ok) throw new Error('HTTP ' + res.status);
    return JSON.parse(text || '{}');
  } finally { clearTimeout(t); }
}

async function testConnection(){
  try{
    setStatus('load', 'TEST…');
    const data = await fetchJson(dom.ollamaUrl.value.trim().replace(/\/$/,'') + '/api/tags');
    state.models = Array.isArray(data.models) ? data.models.map(m=>m.name).filter(Boolean) : [];
    renderModels();
    setStatus('ok', 'CONNECTÉ');
    toast(state.models.length ? `Ollama OK · ${state.models.length} modèle(s)` : 'Ollama OK');
    persist();
  } catch(e){
    setStatus('err', 'ERREUR');
    toast('Ollama inaccessible ou CORS bloqué.');
  }
}

async function refreshModels(){
  try{
    setStatus('load', 'MODÈLES…');
    const data = await fetchJson(dom.ollamaUrl.value.trim().replace(/\/$/,'') + '/api/tags');
    state.models = Array.isArray(data.models) ? data.models.map(m=>m.name).filter(Boolean) : [];
    renderModels();
    setStatus('ok', 'CONNECTÉ');
    toast(state.models.length ? 'Modèles détectés.' : 'Aucun modèle détecté.');
  } catch(e){ setStatus('err', 'ERREUR'); toast('Impossible de récupérer les modèles.'); }
}

function renderModels(){
  dom.modelsPanel.innerHTML = '';
  dom.modelsDatalist.innerHTML = '';
  state.models.forEach(name=>{
    const opt = document.createElement('option'); opt.value = name; dom.modelsDatalist.appendChild(opt);
    const row = document.createElement('div');
    row.className = 'model-item' + (name === dom.ollamaModel.value.trim() ? ' active' : '');
    row.innerHTML = `<span>${escapeHtml(name)}</span><button class="btn-tiny">Choisir</button>`;
    row.addEventListener('click', ()=>{ dom.ollamaModel.value = name; renderModels(); persist(); });
    dom.modelsPanel.appendChild(row);
  });
  dom.modelsPanel.classList.toggle('hidden', !state.models.length);
}

function chooseBestModel(){
  const candidates = state.models.length ? state.models : [dom.ollamaModel.value.trim()].filter(Boolean);
  const prefs = [/qwen2\.5:7b/i,/mistral:latest/i,/mistral/i,/qwen/i,/llama3\.2:3b/i,/gemma3:4b/i,/gemma/i];
  for(const re of prefs){ const found = candidates.find(x=>re.test(x)); if(found){ dom.ollamaModel.value = found; renderModels(); persist(); toast('Modèle conseillé appliqué.'); return; } }
  toast('Aucun meilleur choix évident détecté.');
}

function getActiveSystem(){ return state.userSystemPrompt || SYSTEM_PROMPT; }
function getActiveModePrompt(){ return state.userPrompts[state.currentMode] ?? MODE_CONFIGS[state.currentMode].prompt; }

async function sendMessage(){
  const text = dom.userInput.value.trim();
  if(!text || state.isLoading) return;
  hideEmpty();
  const cfg = MODE_CONFIGS[state.currentMode];
  const baseUrl = dom.ollamaUrl.value.trim().replace(/\/$/,'');
  const model = dom.ollamaModel.value.trim();
  if(!baseUrl || !model){ toast('URL et modèle requis.'); return; }

  appendMessage('user', text, cfg.short);
  dom.userInput.value=''; autoResize(dom.userInput);

  const fullPrompt = buildContext() + getActiveModePrompt() + "\n\n---\nDEMANDE DE L'ENQUÊTEUR :\n" + text;
  const rollbackLen = state.conversationHistory.length;
  state.conversationHistory.push({role:'user', content: fullPrompt});
  updateCtx(); persist();
  state.isLoading = true; dom.sendBtn.disabled = true; setStatus('load','TRAITEMENT');

  const placeholder = appendMessage('assistant', '<span class="spinner"></span>', 'OPJ IA', true);
  let reply = '';
  try{
    const messages = [{role:'system', content: getActiveSystem()}, ...state.conversationHistory.slice(-MAX_CTX_PAIRS*2)];
    const ctrl = new AbortController();
    const timer = setTimeout(()=>ctrl.abort(), 120000);
    const res = await fetch(baseUrl + '/api/chat', {
      method:'POST', headers:{'Content-Type':'application/json'}, signal: ctrl.signal,
      body: JSON.stringify({ model, messages, stream:true, options:{temperature:0.3} })
    });
    clearTimeout(timer);
    if(!res.ok) throw new Error('HTTP ' + res.status);
    const reader = res.body.getReader();
    const decoder = new TextDecoder();
    while(true){
      const {done, value} = await reader.read(); if(done) break;
      const chunk = decoder.decode(value, {stream:true});
      for(const line of chunk.split('\n')){
        const t = line.trim(); if(!t) continue;
        try{
          const obj = JSON.parse(t);
          const delta = obj.message?.content || '';
          if(delta){ reply += delta; placeholder.querySelector('.bubble').innerHTML = renderMd(reply); dom.chatArea.scrollTop = dom.chatArea.scrollHeight; }
        }catch(e){}
      }
    }
    if(!reply.trim()) throw new Error('Réponse vide du modèle');
    state.conversationHistory.push({role:'assistant', content: reply});
    state.sessionHistory.unshift({ mode: cfg.short, text: text.slice(0,80), reply, time: new Date().toISOString() });
    state.sessionHistory = state.sessionHistory.slice(0, MAX_SESSION_ITEMS);
    renderHistory(); updateCtx(); persist(); setStatus('ok','CONNECTÉ');
  } catch(err){
    state.conversationHistory = state.conversationHistory.slice(0, rollbackLen);
    placeholder.querySelector('.bubble').innerHTML = `<span style="color:var(--red)">⚠️ ${escapeHtml(err.name === 'AbortError' ? 'Délai dépassé.' : err.message || 'Erreur')}</span>`;
    setStatus('err','ERREUR'); updateCtx(); persist();
  } finally {
    state.isLoading = false; dom.sendBtn.disabled = false;
  }
}

function appendMessage(role, htmlOrText, badgeText, rawHtml=false){
  const wrap = document.createElement('div'); wrap.className = 'msg ' + role;
  const hm = new Date().toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
  const body = rawHtml ? htmlOrText : (role === 'assistant' ? renderMd(htmlOrText) : escapeHtml(htmlOrText));
  wrap.innerHTML = `<div class="meta"><span class="badge">${escapeHtml(badgeText)}</span><span>${role === 'user' ? 'OPÉRATEUR' : 'TACTIQ'}</span><span>${hm}</span></div><div class="bubble">${body}</div>${role === 'assistant' ? '<div class="actions"><button class="btn-tiny" data-copy>Copier</button><button class="btn-tiny" data-reuse>Réutiliser comme résumé</button></div>' : ''}`;
  if(role === 'assistant'){
    wrap.querySelector('[data-copy]').addEventListener('click', ()=> copyText(wrap.querySelector('.bubble').innerText));
    wrap.querySelector('[data-reuse]').addEventListener('click', ()=>{ dom.dossierSummary.value = wrap.querySelector('.bubble').innerText.slice(0,3000); persist(); toast('Réponse copiée dans le résumé dossier.'); });
  }
  dom.chatArea.appendChild(wrap); dom.chatArea.scrollTop = dom.chatArea.scrollHeight; return wrap;
}

function rebuildChatFromState(){
  hideEmpty();
  dom.chatArea.innerHTML = '';
  for(let i=0;i<state.conversationHistory.length;i+=2){
    const user = state.conversationHistory[i];
    const asst = state.conversationHistory[i+1];
    if(user) appendMessage('user', extractUserVisible(user.content), 'REPRISE');
    if(asst) appendMessage('assistant', asst.content, 'OPJ IA');
  }
}
function extractUserVisible(fullPrompt){ const marker = "DEMANDE DE L'ENQUÊTEUR :\n"; const idx = fullPrompt.lastIndexOf(marker); return idx >= 0 ? fullPrompt.slice(idx + marker.length).trim() : fullPrompt; }

function renderHistory(){
  dom.historyList.innerHTML = '';
  if(!state.sessionHistory.length){ dom.historyList.innerHTML = '<div class="summary">Aucun échange récent.</div>'; return; }
  state.sessionHistory.forEach(item=>{
    const row = document.createElement('div'); row.className = 'hist';
    const time = new Date(item.time);
    row.innerHTML = `<strong>${escapeHtml(item.mode)}</strong><span>${escapeHtml(item.text)}</span><time>${time.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'})}</time>`;
    row.addEventListener('click', ()=>{ hideEmpty(); appendMessage('user', item.text, item.mode); appendMessage('assistant', item.reply, 'REPLAY'); });
    dom.historyList.appendChild(row);
  });
}

function clearSession(){
  if(!confirm('Effacer la session en cours ?')) return;
  state.conversationHistory = []; state.sessionHistory = []; dom.chatArea.innerHTML = ''; dom.emptyState.classList.remove('hidden'); renderHistory(); updateCtx(); persist(); toast('Nouvelle session.');
}

function escapeHtml(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function copyText(text){ navigator.clipboard?.writeText(text).then(()=>toast('Copié.')).catch(()=>toast('Copie impossible.')); }

function renderMd(src){
  let h = escapeHtml(String(src || ''));
  const blocks = [];
  h = h.replace(/```([\s\S]*?)```/g, (_, code)=>{ const i = blocks.push(code)-1; return `\u0000CODE${i}\u0001`; });
  h = h.replace(/^###\s+(.+)$/gm,'<h3>$1</h3>').replace(/^##\s+(.+)$/gm,'<h2>$1</h2>').replace(/^#\s+(.+)$/gm,'<h1>$1</h1>');
  h = h.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>').replace(/\*(.+?)\*/g,'<em>$1</em>').replace(/`([^`]+)`/g,'<code>$1</code>');
  h = h.replace(/(^|\n)\-\s+(.+(?:\n\-\s+.+)*)/g, (m,p1,list)=>{ const items = list.split(/\n\-\s+/).map(x=>x.replace(/^\-\s+/,'').trim()).filter(Boolean).map(x=>`<li>${x}</li>`).join(''); return `${p1}<ul>${items}</ul>`; });
  h = h.split(/\n{2,}/).map(block=>{ block = block.trim(); if(!block) return ''; if(/^<(h\d|ul|pre|blockquote)/.test(block)) return block; return '<p>' + block.replace(/\n/g,'<br>') + '</p>'; }).join('');
  h = h.replace(/\u0000CODE(\d+)\u0001/g, (_,i)=>`<pre><code>${escapeHtml(blocks[+i])}</code></pre>`);
  return h;
}

function exportConversation(type){
  if(!state.conversationHistory.length){ toast('Aucune conversation à exporter.'); return; }
  let body = '';
  for(let i=0;i<state.conversationHistory.length;i++){
    const item = state.conversationHistory[i];
    const label = item.role === 'user' ? 'Utilisateur' : 'Assistant';
    body += (type === 'md' ? `## ${label}\n\n${item.content}\n\n` : `${label.toUpperCase()}\n${item.content}\n\n`);
  }
  const blob = new Blob([body], {type:'text/plain;charset=utf-8'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url; a.download = `tactiq-v2-${new Date().toISOString().replace(/[:.]/g,'-')}.${type}`; a.click(); URL.revokeObjectURL(url);
}

async function handleDocFile(file){
  if(!file) return;
  const name = file.name || 'document';
  const ext = name.toLowerCase().split('.').pop();
  try{
    let text = '';
    if(ext === 'txt' || ext === 'md'){
      text = await file.text();
    } else if(ext === 'pdf'){
      const buf = await file.arrayBuffer();
      const bytes = new Uint8Array(buf);
      const latin = new TextDecoder('latin1').decode(bytes);
      text = (latin.match(/[\x20-\x7EÀ-ÿ\n\r\t]{6,}/g) || []).join(' ');
      text = text.replace(/\s+/g,' ').trim();
      if(text.length < 80) text = 'Extraction PDF limitée. Ce document semble scanné, protégé ou peu textuel.';
    } else {
      toast('Format non pris en charge.');
      return;
    }
    state.doc = { name, ext, text: text.slice(0, 18000), loadedAt: new Date().toISOString() };
    renderDocumentState(); persist(); toast('Document chargé.');
  } catch(e){ toast('Impossible de lire le document.'); }
}

function renderDocumentState(){
  const has = !!state.doc;
  dom.docBadgeWrap.classList.toggle('hidden', !has);
  if(!has){ dom.docName.textContent='—'; dom.docMeta.textContent=''; return; }
  dom.docName.textContent = state.doc.name;
  dom.docMeta.textContent = `${state.doc.ext.toUpperCase()} · ${state.doc.text.length.toLocaleString('fr-FR')} caractères disponibles`;
}
function clearDocument(){ state.doc = null; dom.docInput.value = ''; renderDocumentState(); persist(); toast('Document retiré.'); }
function injectDocTemplate(kind){
  if(!state.doc?.text){ toast('Aucun document chargé.'); return; }
  const prompt = kind === 'questions'
    ? `À partir du document chargé, génère des questions d'audition exploitables, classées par thèmes, avec objectifs et points de confrontation.`
    : `Analyse le document chargé et fais une synthèse judiciaire structurée : faits, contradictions, chronologie, points d'attention et actes utiles.`;
  dom.userInput.value = prompt; autoResize(dom.userInput); dom.userInput.focus(); hideEmpty();
}

init();
</script>
